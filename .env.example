# =============================================================================
# «Домашняя выпечка» — пример файла переменных окружения
# =============================================================================
# Как использовать:
#   1. Скопируйте файл в .env в корне репозитория:
#        Linux/macOS:  cp .env.example .env
#        Windows:      Copy-Item .env.example .env
#   2. Заполните значения. Пустое значение означает «не настроено»: интеграция
#      отключается, система работает дальше (например, передаёт диалог оператору).
#   3. Файл .env НИКОГДА не коммитится в Git — в нём пароли и ключи API
#      (.env уже в .gitignore). В .env.example реальные значения не вписывать.
#
# Формат:
#   - одна переменная на строку: ИМЯ=значение, без пробелов вокруг «=»;
#   - комментарий — только отдельной строкой, начинающейся с «#»;
#   - не используйте символ «$» в значениях (docker compose подставляет
#     переменные); если без него никак — возьмите значение в одинарные кавычки;
#   - после изменения .env пересоздайте контейнеры: docker compose up -d
#     (docker compose restart .env НЕ перечитывает).
#
# Случайный секрет (буквы, цифры, «-», «_» — безопасно для URL):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# -----------------------------------------------------------------------------
# Приложение
# -----------------------------------------------------------------------------
# Режим: development | production | test.
# На сервере — только production: /api/docs отключается, подпись webhook
# Instagram обязательна.
APP_ENV=development

# Секрет приложения для подписи служебных токенов (для JWT НЕ используется —
# там отдельный JWT_SECRET). Длинная случайная строка, см. генерацию выше.
APP_SECRET_KEY=

# Публичный адрес backend: схема и домен, без «/» в конце.
# Из него строятся URL webhook Instagram ({PUBLIC_BASE_URL}/api/webhooks/instagram)
# и ссылки на аудиофайлы голосовых ответов ({PUBLIC_BASE_URL}/api/media/...).
# В production — только HTTPS с валидным сертификатом, адрес доступен из интернета.
PUBLIC_BASE_URL=http://localhost:8000

# Публичный адрес админ-панели (frontend). Из него строятся ссылки клиенту
# «Отметьте точку доставки»: {FRONTEND_PUBLIC_URL}/l/{token}.
FRONTEND_PUBLIC_URL=http://localhost:3000

# Разрешённые источники CORS через запятую — адрес(а) админ-панели.
CORS_ORIGINS=http://localhost:3000

# Часовой пояс бизнеса: «сегодня», периоды статистики, время ежедневного отчёта.
BUSINESS_TIMEZONE=Asia/Dushanbe

# Уровень логов: DEBUG | INFO | WARNING | ERROR. В production — INFO.
LOG_LEVEL=INFO

# Каталог файлов (аудио голосовых ответов) внутри контейнера.
# В docker compose всегда /app/media (именованный том media) — менять не нужно.
MEDIA_ROOT=/app/media

# -----------------------------------------------------------------------------
# База данных и Redis
# -----------------------------------------------------------------------------
# Подключение SQLAlchemy к PostgreSQL (драйвер psycopg 3).
# В docker compose для backend/worker/beat собирается АВТОМАТИЧЕСКИ из
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB (хост postgres), значение ниже
# там не используется. Нужно только при запуске backend без Docker
# (тогда хост обычно localhost, пароль — ваш).
DATABASE_URL=postgresql+psycopg://bakery:change-me@postgres:5432/bakery

# Redis: брокер и результаты Celery, кэш геокодера, счётчики rate limiting.
# В docker compose всегда redis://redis:6379/0.
REDIS_URL=redis://redis:6379/0

# Пользователь и база, которые контейнер postgres создаёт при ПЕРВОМ запуске.
# Если том БД уже создан, изменение этих значений ничего не меняет.
POSTGRES_USER=bakery

# ОБЯЗАТЕЛЬНО. Пароль PostgreSQL. Только латинские буквы, цифры, «-» и «_»
# (пароль подставляется в URL подключения). С пустым значением
# docker compose не запустится.
POSTGRES_PASSWORD=

POSTGRES_DB=bakery

# -----------------------------------------------------------------------------
# Авторизация администраторов
# -----------------------------------------------------------------------------
# ОБЯЗАТЕЛЬНО. Секрет подписи JWT (HS256): случайная строка от 32 символов.
# При смене все пользователи будут разлогинены.
JWT_SECRET=

# Время жизни access-токена, минут.
JWT_ACCESS_TTL_MINUTES=30

# Время жизни refresh-токена, дней.
JWT_REFRESH_TTL_DAYS=14

# Логин первого администратора. Создаётся при старте backend
# (python -m scripts.create_admin), только если задан FIRST_ADMIN_PASSWORD.
FIRST_ADMIN_USERNAME=admin

# Пароль первого администратора, не короче 8 символов. Пусто — не создавать.
# После первого входа смените пароль в разделе «Пользователи» и очистите это значение.
FIRST_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Instagram (Instagram API with Instagram Login, graph.instagram.com)
# -----------------------------------------------------------------------------
# Всё берётся в Meta App Dashboard (https://developers.facebook.com/apps):
# приложение типа Business → Instagram → «API setup with Instagram business login».
# Подробности — docs/research/instagram.md.

# Долгоживущий токен Instagram User (действует 60 дней): кнопка «Generate token»
# напротив подключённого профессионального аккаунта. Backend продлевает его
# ежедневной задачей; если токен всё же истёк — сгенерируйте новый
# (docs/deployment-notes.md, раздел про токен Instagram).
INSTAGRAM_ACCESS_TOKEN=

# Строка, которую вы придумываете сами (случайная, см. генерацию выше) и вводите
# в Dashboard при настройке webhook в поле «Verify Token».
# Callback URL там же: {PUBLIC_BASE_URL}/api/webhooks/instagram
INSTAGRAM_VERIFY_TOKEN=

# Instagram App Secret — на той же странице «API setup with Instagram business
# login» (не путать с App Secret Meta-приложения). Нужен для проверки подписи
# webhook (X-Hub-Signature-256).
INSTAGRAM_APP_SECRET=

# Необязательно. App Secret самого Meta-приложения (App settings → Basic).
# Подпись webhook проверяется по обоим секретам: документация Meta не уточняет,
# какой из них используется.
META_APP_SECRET=

# ID профессионального аккаунта Instagram (приходит в entry[].id webhook).
# Узнать: GET https://graph.instagram.com/v25.0/me?fields=user_id,username
# с заголовком «Authorization: Bearer <токен>» — нужно поле user_id (не id).
INSTAGRAM_ACCOUNT_ID=

# Базовый URL Graph API. Менять не нужно.
INSTAGRAM_GRAPH_URL=https://graph.instagram.com

# Версия Graph API. Менять только при осознанном переходе на новую версию.
INSTAGRAM_API_VERSION=v25.0

# -----------------------------------------------------------------------------
# LLM (Anthropic Claude или Google Gemini)
# -----------------------------------------------------------------------------
# Провайдер: anthropic (по умолчанию) | gemini.
LLM_PROVIDER=anthropic

# Ключ API выбранного провайдера. Anthropic: Claude Console
# (https://platform.claude.com) → API Keys. Gemini: Google AI Studio
# (https://aistudio.google.com) → Get API key. Без ключа AI-ответы не работают —
# диалоги передаются оператору.
# Внимание: на бесплатном тарифе Gemini Google может использовать переписку для
# улучшения своих продуктов — для реальных клиентов нужен платный ключ.
LLM_API_KEY=

# Модель: для anthropic — например claude-opus-5; для gemini — например gemini-3.8-flash.
LLM_MODEL=claude-opus-5

# Только для anthropic. Уровень «усилия» модели: low | medium | high | xhigh | max.
# Выше — тщательнее, но медленнее и дороже; medium — баланс для чата с клиентами.
LLM_EFFORT=medium

# Таймаут одного запроса к LLM, секунд.
LLM_TIMEOUT_SECONDS=60

# Экономия запросов (полезно на бесплатных тарифах, например Gemini).
# false — тексты ответов берутся из шаблонов без обращения к модели (на сообщение
# уходит на 1 запрос меньше; ответы точные, но менее «живые»).
LLM_REPLY_WORDING_ENABLED=true
# false — разбор сообщения без инструментов чтения (каталог и FAQ и так в промпте):
# без лишних раундов запросов.
LLM_TOOLS_ENABLED=true

# Только для anthropic. true — при отказе модели Anthropic автоматически отвечает резервной моделью
# (серверные fallbacks); false — не использовать.
LLM_FALLBACKS_ENABLED=true

# -----------------------------------------------------------------------------
# Речь: распознавание голосовых (STT) и голосовые ответы (TTS)
# -----------------------------------------------------------------------------
# Провайдер распознавания речи: elevenlabs (модель scribe_v2, русский и таджикский).
STT_PROVIDER=elevenlabs

# Ключ ElevenLabs: https://elevenlabs.io → настройки аккаунта → API Keys.
# Без ключа голосовые не распознаются: клиента просят написать текстом.
STT_API_KEY=

# Провайдер синтеза речи: openai (gpt-4o-mini-tts). Голосовые ответы включает
# администратор в «Настройках»; таджикский синтез не поддерживается (только текст).
TTS_PROVIDER=openai

# Ключ OpenAI: https://platform.openai.com/api-keys
TTS_API_KEY=

# Голос OpenAI TTS: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage,
# shimmer, verse, marin, cedar.
TTS_VOICE=alloy

# -----------------------------------------------------------------------------
# Карты: геокодирование и маршруты
# -----------------------------------------------------------------------------
# Геокодер адресов: nominatim (OpenStreetMap, по умолчанию, без ключа) | google.
GEOCODER_PROVIDER=nominatim

# Ключ Google Maps Platform — только при GEOCODER_PROVIDER=google.
# Google Cloud Console → APIs & Services → Credentials; включите Geocoding API
# и ограничьте ключ IP-адресом сервера. Лицензия Google: координаты хранить
# не дольше 30 дней и не показывать на не-Google карте.
MAPS_API_KEY=

# Сервер Nominatim. Публичный — не более 1 запроса в секунду, без гарантий.
NOMINATIM_URL=https://nominatim.openstreetmap.org

# User-Agent для Nominatim — укажите РЕАЛЬНЫЙ контакт (e-mail или сайт).
# Публичный сервер отвечает 403 «Access denied» на стандартные агенты и на
# любые с example.com — тогда ни один адрес «не находится».
# Пример: bakery-bot/1.0 (info@my-bakery.tj)
NOMINATIM_USER_AGENT=

# URL сервера OSRM (время и расстояния по дорогам для оптимизации маршрута).
# Пусто — оценка по прямой (haversine × 1.3).
# Со встроенным контейнером (профиль compose «routing»): http://osrm:5000
# Подготовка данных — docs/deployment-notes.md. Публичный демо-сервер OSRM
# для коммерческого использования не предназначен.
OSRM_URL=

# Город доставки (подсказка геокодеру).
CITY_NAME=Худжанд

# Границы города: юг,запад,север,восток (широта_мин,долгота_мин,широта_макс,долгота_макс).
# Значения проверены по OpenStreetMap (Nominatim boundary для "Khujand, Tajikistan").
CITY_BBOX=40.2623896,69.5612523,40.3316825,69.6740681

# Центр города: широта,долгота (внутри CITY_BBOX).
CITY_CENTER=40.2842191,69.6191174

# Время ежедневного отчёта по умолчанию, ЧЧ:ММ в BUSINESS_TIMEZONE. Это только
# начальное значение: действующее время задаётся в админ-панели («Настройки»).
DAILY_REPORT_TIME=21:00

# -----------------------------------------------------------------------------
# Maxim (курьерская доставка)
# -----------------------------------------------------------------------------
# manual — оператор оформляет доставку в приложении Maxim вручную по «Листу для
# Maxim» (единственный рабочий режим). api — зарезервировано и не реализовано:
# официального API Maxim нет (docs/research/maxim.md).
MAXIM_MODE=manual

# Ключ и адрес официального API Maxim. Оставьте пустыми, пока Maxim
# не предоставит документацию и договор.
MAXIM_API_KEY=
MAXIM_API_URL=

# -----------------------------------------------------------------------------
# Frontend (админ-панель Next.js)
# -----------------------------------------------------------------------------
# Название в интерфейсе. Встраивается в сборку frontend, после изменения
# пересоберите: docker compose up -d --build frontend
NEXT_PUBLIC_APP_NAME=Домашняя выпечка

# Внутренний адрес backend, куда Next.js проксирует /api/*.
# В docker compose задаётся при сборке как http://backend:8000.
# При запуске frontend без Docker — http://localhost:8000.
BACKEND_INTERNAL_URL=http://backend:8000

# -----------------------------------------------------------------------------
# Docker Compose (приложением не читается)
# -----------------------------------------------------------------------------
# Раскомментируйте, чтобы OSRM запускался обычной командой docker compose up -d.
# COMPOSE_PROFILES=routing

# Необязательно. От каких адресов backend (uvicorn) принимает заголовки
# X-Forwarded-For/-Proto — IP или сети через запятую. По умолчанию loopback и
# частные сети (reverse proxy на этом же сервере, контейнер frontend).
# Раскомментируйте, если reverse proxy работает на другом сервере с публичным IP.
# FORWARDED_ALLOW_IPS=203.0.113.10
